# Never in this repository (hard rule): no patient data, no binaries, no runtimes.
# The archive data lives outside the repository; what travels in git is the manifest of
# SeriesInstanceUIDs that identifies it.
*.exe
*.dll
*.dcm
*.ima
*.raw

# The per-series index is a cache of the archive directory, rebuilt in one pass.
ldct_io_index.json

# trained checkpoints and intermediate arrays: regenerate, do not track
results/*.pt
results/*.npz
